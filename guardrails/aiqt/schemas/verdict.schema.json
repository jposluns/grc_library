{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiqt.ai/schemas/verdict.schema.json",
  "title": "AIQT review verdict envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "counts", "proof_of_run", "head", "base", "model"],
  "properties": {
    "verdict": {"enum": ["SHIP", "HOLD"]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "warning", "note"],
      "properties": {
        "error": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "note": {"type": "integer", "minimum": 0}
      }
    },
    "proof_of_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_read", "commands_run", "checks_passed"],
      "properties": {
        "files_read": {"type": "integer", "minimum": 0},
        "commands_run": {"type": "array", "items": {"type": "string"}},
        "checks_passed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "head": {"type": "string", "minLength": 7},
    "base": {"type": "string", "minLength": 7},
    "model": {"type": "string", "minLength": 1}
  }
}
