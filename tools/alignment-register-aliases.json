  "umbrella": [
    {"pattern": "(?:US )?HIPAA(?: (?:Privacy|Security|Breach Notification) Rule| Enforcement| Administrative Simplification.*)?", "row": "US HIPAA"},
    {"pattern": "NERC CIP(?:-\\d{3}(?:-\\d+)?)?", "row": "NERC CIP"},
    {"pattern": "NIST SP 800-63B(?:-4)?", "row": "NIST SP 800-63B"},
    {"pattern": "NIST SP 1900-\\d+", "row": "NIST SP 1900 series"},
    {"pattern": "ISO/IEC 5259-\\d", "row": "ISO/IEC 5259"},
    {"pattern": "ISO/IEC 27034-\\d(?:-\\d)?", "row": "ISO/IEC 27034"},
    {"pattern": "ISO 15489-\\d", "row": "ISO 15489"},
    {"pattern": "ISO 16484-\\d", "row": "ISO 16484"},
    {"pattern": "EN 54-\\d+", "row": "EN 54"},
    {"pattern": "ISA(?:/IEC)? 62443", "row": "IEC 62443-1-1"},
    {"pattern": "BASC(?: v6| V6-2022| International (?:Norm|Standard)(?: v6)?| Sec Std| Norm)?", "row": "BASC International Norm V6-2022 (Control and Security Management System, CSMS)"},
    {"pattern": "BASC International Security Standard 6\\.0\\.[23](?:/6\\.0\\.[23])?", "row": "BASC International Security Standard 6.0.2 (2022, companies with indirect relation to the cargo)"}
  ],
  "not_citable": {
