#!/bin/sh
# git-native pre-commit hook: refuse a commit on a grc_library main/master checkout (P-TODO 3b17),
# then a commit that changes a Version or Date line or a generated output while the staged taxonomy.yml,
# docs/portal.md or docs/maturity-scorecard.md is out of sync (P-TODO 3b200), then a commit that stages
# CHANGELOG.md while tools/preflight-changelog.py --staged fails.
#
# A persistent shim installed by tools/install-git-hooks.sh in the shared hooks dir resolves the
# active checkout and execs THIS tracked file at commit time, which delegates to the tested Python
# implementations in tools/check-commit-on-main.py, tools/check-generated-commit.py and
# tools/check-changelog-preflight-commit.py.
# NOT a pre-commit-framework hook.
root="$(git rev-parse --show-toplevel)"
python3 "$root/tools/check-commit-on-main.py" --pre-commit || exit $?
# FAILS OPEN for a tree that carries this shim without the generated-output check (the commit-on-main,
# Version-bump and CHANGELOG self-test fixtures copy the shim without it).
if [ -f "$root/tools/check-generated-commit.py" ]; then
  python3 "$root/tools/check-generated-commit.py" --pre-commit || exit $?
fi
# FAILS OPEN for a tree that carries this shim without the CHANGELOG check (the commit-on-main and
# Version-bump self-test fixtures copy the shim without it).
[ -f "$root/tools/check-changelog-preflight-commit.py" ] || exit 0
exec python3 "$root/tools/check-changelog-preflight-commit.py" --pre-commit
